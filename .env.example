# lattice-rag Environment Configuration
# Copy this file to .env and fill in your API keys.
# NEVER commit .env or apikeys.md to git.

# ===========================
# API Keys (Required)
# ===========================

# TypeSafe AI Jev — System 1 routing, Noul guardrails, Score eval gate
# Get yours at: https://console.typesafe.ai/
TYPESAFE_API_KEY=

# GroqCloud — Primary LLM synthesizer (Llama 3.3 70B / DeepSeek-R1)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=

# Google AI Studio — Gemini 2.5 Flash fallback for massive context
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===========================
# Infrastructure
# ===========================

# Redis — Tier 2 circuit breaker fallback cache
REDIS_URL=redis://localhost:6379/0

# ===========================
# Storage
# ===========================

# LatticeDB embedded database file path
LATTICEDB_PATH=data/lattice_rag.db

# ===========================
# Server
# ===========================

HOST=0.0.0.0
PORT=8000

# ===========================
# Embedding Models
# ===========================

# FastEmbed dense embedding model
EMBED_MODEL=BAAI/bge-small-en-v1.5

# FastEmbed cross-encoder reranker model
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
