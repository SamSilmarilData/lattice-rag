# lattice-rag Environment Configuration
# Copy this file to .env and fill in your API keys.
# NEVER commit .env or apikeys.md to git.

# ===========================
# API Keys
# ===========================

# TypeSafe AI Jev — routing, Noul guardrail, semantic-cache verification, Score eval gate.
# Without it the server still starts in degraded mode (routes fall back to hybrid,
# guardrail/verification disabled, /health reports "degraded"). CLI query/eval require it.
# Get yours at: https://console.typesafe.ai/
TYPESAFE_API_KEY=

# GroqCloud — primary LLM synthesizer. Optional: without it answers come from Gemini.
# Get yours at: https://console.groq.com/
GROQ_API_KEY=

# Google AI Studio — Gemini fallback and massive-context synthesizer. Optional.
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===========================
# Access Control
# ===========================

# Required for POST /api/v1/ingest, /api/v1/eval/jobs, /api/v1/benchmark/run,
# GET /api/v1/graph/subgraph and GET /api/v1/cache/stats
# (sent as the X-Admin-Key header). Leave empty to disable those endpoints entirely.
ADMIN_API_KEY=

# Comma-separated browser origins allowed to call the API cross-origin.
# Empty = same-origin only. The Vite dev server proxies /api, so it needs no entry.
CORS_ALLOW_ORIGINS=

# Rerank-score Noul skip (off by default). Chunks whose cross-encoder score (raw logit) is
# at or above this value skip the Jev Noul context guardrail. Leave empty unless Live Tier
# runs with the value show no quality loss (docs/production-readiness.md, section 6).
GUARDRAIL_SKIP_RERANK_SCORE=

# Per-client request limit for /api/v1/query and /api/v1/query/stream
QUERY_RATE_LIMIT_PER_MINUTE=60

# Number of reverse proxies in front of the app whose X-Forwarded-For entries are trusted.
# 0 (default) identifies clients by the socket peer and ignores X-Forwarded-For, which any
# client can forge. With N > 0 the client is the Nth entry from the right; entries further
# left are ignored. Use 1 behind a single proxy (Cloud Run, nginx, cloudflared), 2 behind
# a load balancer plus a proxy. Setting it higher than the real hop count lets clients
# spoof their identity. The same identity drives the admin-key lockout (5 failures/5 min).
TRUSTED_PROXY_HOPS=0

# ===========================
# Models
# ===========================

GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
# Maximum tokens per Groq answer
LLM_MAX_TOKENS=256

# FastEmbed dense embedding model (384-dim; must match the LatticeDB vector index)
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Cross-encoder reranker. bge-reranker-v2-m3 runs from its INT8 ONNX export below.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_ONNX_REPO=onnx-community/bge-reranker-v2-m3-ONNX
# Set to a Hugging Face commit hash to pin the downloaded weights
RERANKER_ONNX_REVISION=

# ===========================
# Infrastructure
# ===========================

# Tier 2 fallback-FAQ store. "embedded" runs an in-process fakeredis (no server needed);
# set a URL such as redis://localhost:6379/0 to use a real Redis.
REDIS_URL=embedded

# LatticeDB embedded database file path
LATTICEDB_PATH=data/lattice_rag.db

# ===========================
# Server
# ===========================

HOST=0.0.0.0
PORT=8000
